<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="28dp"
    android:background="@drawable/bg_overlay_card">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="6dp">

    <!-- Limit message -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👀  "
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />
    <TextView
        android:id="@+id/messageText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Limit exceeded 5 times"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:gravity="center"
        android:layout_marginBottom="12dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingVertical="6dp"
        android:layout_marginBottom="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="💡 "
        android:textColor="#FFF8E5"
        android:textSize="26sp"
        android:gravity="top"
        android:lineSpacingExtra="4dp"/>
        <!-- Motivational quote -->
    <TextView
        android:id="@+id/quoteText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You are braver than you believe, stronger than you seem, and smarter than you think."
        android:textColor="#FFF8E5"
        android:textSize="16sp"
        android:lineSpacingExtra="4dp"/>

    </LinearLayout>

    <!-- Button Row -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_marginTop="8dp">

        <!-- Snooze Button -->
        <Button
            android:id="@+id/closeButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingHorizontal="28dp"
            android:text="⌛  SNOOZE"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_overlay_button" />

        <!-- Go to App Button -->
        <Button
            android:id="@+id/openAppButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingHorizontal="28dp"
            android:text="📱  OPEN APP"
            android:textAllCaps="false"
            android:textColor="#000000"
            android:textStyle="bold"
            android:background="@drawable/bg_overlay_button" />
    </LinearLayout>


</LinearLayout>
