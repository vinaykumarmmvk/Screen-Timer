<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#A99E79"
    android:fillViewport="true"
    android:paddingTop="@dimen/top_extra_gap">

    <LinearLayout
        android:id="@+id/contentContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_img"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:paddingBottom="20dp"
        android:paddingTop="8dp">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:text="Notify Screen Time"
            android:textStyle="bold"
            android:textSize="20sp"
            android:textColor="#000000"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="24dp" />

        <!-- Timer (minutes) card -->
        <LinearLayout
            android:id="@+id/cardTimer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:elevation="2dp"
            android:padding="16dp"
            android:layout_marginBottom="20dp">

            <!-- Row: label + stepper pill -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:baselineAligned="false">

                <!-- Label -->
                <TextView
                    android:id="@+id/tvTimerLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Timer (minutes)"
                    android:textColor="#000000"
                    android:textStyle="bold"
                    android:textSize="16sp" />

                <!-- Stepper pill: - [30] + -->
                <LinearLayout
                    android:id="@+id/rowStepper"
                    android:layout_width="150dp"
                    android:layout_height="60dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_stepper_pill"
                    android:paddingVertical="6dp"
                    android:paddingHorizontal="8dp"
                    android:minWidth="14dp">

                    <!-- minus -->
                    <TextView
                        android:id="@+id/btnMinus"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="−"
                        android:textSize="25sp"
                        android:textStyle="bold"
                        android:textColor="#1D2531"
                        android:textAlignment="center"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                    <!-- divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#66444444" />

                    <!-- editable number -->
                    <EditText
                        android:id="@+id/editTextTimer"
                        android:layout_width="50dp"
                        android:layout_height="wrap_content"
                        android:inputType="number"
                        android:text="30"
                        android:textStyle="bold"
                        android:textColor="#273142"
                        android:textSize="20sp"
                        android:gravity="center"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="2dp"
                        android:background="@android:color/transparent" />

                    <!-- divider -->
                    <View
                        android:layout_width="1dp"
                        android:layout_height="24dp"
                        android:background="#66444444" />

                    <!-- plus -->
                    <TextView
                        android:id="@+id/btnPlus"
                        android:layout_width="40dp"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp"
                        android:text="+"
                        android:textSize="24sp"
                        android:textStyle="bold"
                        android:textColor="#1D2531"
                        android:textAlignment="center"
                        android:background="?attr/selectableItemBackgroundBorderless" />

                </LinearLayout>

            </LinearLayout>

        </LinearLayout>

        <!-- Note toggle row (checkbox + info) -->
        <LinearLayout
            android:id="@+id/noteHeaderRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false"
            android:layout_marginBottom="8dp">

            <CheckBox
                android:id="@+id/checkBoxAddNote"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Add a note (optional)"
                android:textColor="#2A2A2A"
                android:textSize="16sp"
                android:checked="false"/>

            <ImageButton
                android:id="@+id/btnInfo"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:padding="8dp"
                android:layout_marginStart="6dp"
                android:contentDescription="What is this?"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_info_24"
                app:tint="#666666" />
        </LinearLayout>

        <!-- Note text area (hidden until checkbox checked) -->
        <EditText
            android:id="@+id/etNote"
            android:layout_width="match_parent"
            android:layout_height="120dp"
            android:hint="Optional note (e.g. why you're using the timer)"
            android:visibility="gone"
            android:inputType="textMultiLine"
            android:gravity="top|start"
            android:padding="12dp"
            android:textColorHint="#505254"
            android:textColor="#273142"
            android:textSize="16sp"
            android:background="@drawable/bg_input"
            android:layout_marginBottom="20dp" />

        <!-- START button -->
        <Button
            android:id="@+id/btnStart"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginBottom="24dp"
            android:text="Start timer"
            android:textAllCaps="false"
            android:textStyle="bold"
            android:textColor="#000000"
            android:textSize="16sp"
            android:background="@drawable/bg_button_stop" />

        <!-- Disable Timer card row (still hidden for now) -->
        <LinearLayout
            android:id="@+id/cardDisable"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginBottom="22dp"
            android:background="@drawable/bg_card"
            android:elevation="2dp"
            android:gravity="center_vertical"
            android:paddingStart="16dp"
            android:paddingEnd="12dp"
            android:visibility="gone">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Disable Timer"
                android:textColor="#2A2A2A"
                android:textSize="16sp" />

            <Switch
                android:id="@+id/switch_timer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false" />
        </LinearLayout>

        <!-- Bottom links block still hidden -->
        <LinearLayout
            android:id="@+id/linkBlock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:alpha="0.7"
            android:padding="5dp"
            android:visibility="gone"
            android:layout_gravity="end">

            <TextView
                android:id="@+id/aboutApp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="About Notify app"
                android:textColor="#123DCE"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/aboutDeveloper"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:padding="8dp"
                android:text="About Developer"
                android:textColor="#123DCE"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
