<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#A99E79"
    android:fillViewport="true">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_img"
        android:orientation="vertical"
        android:padding="20dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Title -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="Notify Screen Time"
            android:textStyle="bold"
            android:textSize="22sp"
            android:textColor="#000000"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="36dp" />

        <!-- Current timer card -->
        <LinearLayout
            android:id="@+id/cardCurrent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card"
            android:padding="14dp"
            android:elevation="2dp"
            android:layout_margin="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Current timer: "
                android:textSize="19sp"
                android:textColor="#000000"/>
            <TextView
                android:id="@+id/textViewTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="  10 minutes"
                android:textSize="19sp"
                android:textColor="#000000"/>
        </LinearLayout>

        <LinearLayout
            android:orientation="horizontal"
            android:gravity="left"
            android:padding="2dp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="30dp"
            android:visibility="gone">

            <TextView
                android:text="Count of exceeded time: "
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25dp"/>

            <TextView
                android:id="@+id/textViewCount"
                android:text="9999"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="25dp"/>

        </LinearLayout>


        <!-- Big circular progress with time inside -->
        <FrameLayout
            android:id="@+id/timerRing"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="18dp"
            android:layout_gravity="center">

            <!-- Material circular indicator (determinate) -->
            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/progress"
                android:layout_width="260dp"
                android:layout_height="260dp"
                android:layout_gravity="center"
                android:indeterminate="false"
                android:max="100"
                android:progress="75"
                app:indicatorSize="260dp"
                app:trackThickness="16dp"
                app:trackCornerRadius="16dp"
                app:indicatorDirectionCircular="counterclockwise"
                app:trackColor="#FFFFFFFF"
                app:indicatorColor="#FFB46A"
                android:background="@drawable/bg_circle"/>

            <!-- Time text -->
            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="30m"
                android:textColor="#2B2B2B"
                android:textSize="40sp"
                android:textStyle="bold" />
        </FrameLayout>


        <!-- Start / Stop segmented buttons -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="78dp"
            android:orientation="horizontal"
            android:layout_gravity="center"
            android:layout_marginBottom="18dp">

            <Button
                android:id="@+id/stopButton"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="START"
                android:textStyle="bold"
                android:textColor="#203864"
                android:background="@drawable/bg_button_start"
                android:visibility="gone"/>

            <Button
                android:id="@+id/btnStop"
                android:layout_width="180dp"
                android:layout_height="match_parent"
                android:padding="5dp"
                android:layout_weight="1"
                android:text="STOP"
                android:textStyle="bold"
                android:textColor="#000000"
                android:layout_margin="5dp"
                android:textSize="19sp"
                android:background="@drawable/bg_button_stop" />
        </LinearLayout>

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>